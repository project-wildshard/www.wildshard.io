// The marketing site on Cloudflare Workers static assets (meta WWW-CLOUDFLARE-PLAN, J271).
// `bash src/site/tools/deploy.sh` builds HEAD and deploys it; `pnpm site:deploy:cf` deploys an existing src/site/dist.
{
  "name": "wildshard-www",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // The Worker sees every request: the www redirect, /media/v/ from R2 and the cache headers.
    "run_worker_first": true
  },
  // Private bucket; the Worker reads only site/media/<hashed>.mp4 from it (publish-media.ts writes there).
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "wildshard-records" }],
  // Custom domains (they own the DNS records): the apex serves, www 308s to it in worker.ts, as on Vercel.
  "routes": [
    { "pattern": "wildshard.io", "custom_domain": true },
    { "pattern": "www.wildshard.io", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
