{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "all",
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "bracketSpacing": true,
  "sortPackageJson": false,
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      "internal",
      ["parent", "sibling", "index"],
      [
        "type-external",
        "type-internal",
        "type-parent",
        "type-sibling",
        "type-index"
      ]
    ],
    "newlinesBetween": true
  },
  "ignorePatterns": [
    // Plain-JS repo scripts, outside the TS project; covered by
    // `pnpm test:hooks` instead. (.githooks/ sits outside src/.)
    "scripts/**",
    "dist/**",
    "node_modules/**",
    "test-results/**",
    "playwright-report/**",
    "pnpm-lock.yaml",
    "**/*.md"
  ],
  "overrides": [
    {
      "files": ["*.json", "*.jsonc"],
      "options": { "trailingComma": "none" }
    }
  ]
}
