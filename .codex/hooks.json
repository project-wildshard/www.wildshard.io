{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/session-brief.sh\"",
            "statusMessage": "Reading the session brief"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/session-cleanup.mjs\"",
            "timeout": 10,
            "statusMessage": "Stopping processes left by ended sessions"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/pkill-guard.mjs\"",
            "statusMessage": "Checking for a kill by name or pattern"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/guard-git-add.sh\"",
            "statusMessage": "Checking shared Git index safety"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/guard-herdr-prompt.sh\"",
            "statusMessage": "Checking herdr targets for an open question"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/no-pr-guard.mjs\"",
            "statusMessage": "Checking for a pull request on a project-wildshard repo"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/no-sound-guard.mjs\"",
            "statusMessage": "Checking for a command that makes a sound"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/active-hours.mjs\" mark",
            "statusMessage": "Recording active agent time"
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/active-hours.mjs\" mark",
            "statusMessage": "Recording active agent time"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/md-prose-width.sh\"",
            "statusMessage": "Checking markdown prose width"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/subagent-cleanup.mjs\"",
            "timeout": 30,
            "statusMessage": "Stopping the finished lane's processes"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/session-cleanup.mjs\"",
            "timeout": 10,
            "statusMessage": "Stopping the ended session's processes"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/scratch-end.mjs\"",
            "timeout": 10,
            "statusMessage": "Reporting this session's scratch for manual cleanup"
          }
        ]
      }
    ]
  }
}
