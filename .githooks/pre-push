#!/usr/bin/env bash
# 1. Outgoing-commit checks: .githooks/check-push.mjs (reads git's ref
#    lines on stdin). Bypasses: ALLOW_BIG=1, ALLOW_SECRET=1.
# 2. AGENTS.md (J241): .githooks/agents-md.mjs, the same ref lines.
# 3. Push lane (full `pnpm check`): .githooks/run-checks.mjs.
#    Bypass: SKIP_CHECK=1.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
hooks="$(git rev-parse --show-toplevel)/.githooks"
refs="$(cat)"
# $2 is the push URL: a new ref (a first plan/<slug> push, J240) is
# scanned only for the commits that destination lacks.
printf '%s\n' "$refs" | node "$hooks/check-push.mjs" "$2"
printf '%s\n' "$refs" | node "$hooks/agents-md.mjs" push
export WS_PUSH_REFS="$refs"
exec node "$hooks/run-checks.mjs" push
