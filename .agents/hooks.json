{
  "hooks": [
    {
      "event": "SessionStart",
      "script": ".agents/hooks/session-brief.sh",
      "status": "Reading the session brief"
    },
    {
      "event": "PreToolUse",
      "tools": "shell",
      "script": ".agents/hooks/guard-git-add.sh",
      "status": "Checking shared Git index safety"
    },
    {
      "event": "PreToolUse",
      "tools": "shell",
      "script": ".agents/hooks/guard-herdr-prompt.sh",
      "status": "Checking herdr targets for an open question"
    },
    {
      "event": "PreToolUse",
      "tools": "shell",
      "script": ".agents/hooks/no-pr-guard.mjs",
      "status": "Checking for a pull request on a project-wildshard repo"
    },
    {
      "event": "PreToolUse",
      "tools": "shell",
      "script": ".agents/hooks/active-hours.mjs",
      "args": [
        "mark"
      ],
      "status": "Recording active agent time"
    },
    {
      "event": "PreToolUse",
      "tools": "edit",
      "script": ".agents/hooks/active-hours.mjs",
      "args": [
        "mark"
      ],
      "status": "Recording active agent time"
    },
    {
      "event": "PostToolUse",
      "tools": "edit",
      "script": ".agents/hooks/md-prose-width.sh",
      "status": "Checking markdown prose width"
    },
    {
      "event": "SubagentStop",
      "script": ".agents/hooks/subagent-cleanup.mjs",
      "status": "Stopping the finished lane's processes",
      "timeout": 30
    },
    {
      "event": "SessionEnd",
      "script": ".agents/hooks/scratch-end.mjs",
      "status": "Reporting this session's scratch for manual cleanup",
      "timeout": 10
    }
  ]
}
